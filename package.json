{
  "name": "ariadne",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:setup": "prisma db push",
    "test": "tsx --conditions=react-server --test tests/integration/pipeline.test.ts tests/unit/signup-guard.test.ts && tsx --test tests/unit/helpers.test.ts tests/unit/review-features.test.ts tests/unit/intervene.test.ts tests/unit/campaign.test.ts tests/unit/feedback.test.ts tests/unit/workspace.test.ts tests/unit/knots.test.ts tests/unit/verifier.test.ts && node --test tests/integration/migrations.test.mjs",
    "test:all": "bash tests/integration/run-all.sh",
    "postinstall": "node scripts/workers-ci-build.mjs"
  },
  "allowScripts": {
    "esbuild@0.25.4 || 0.28.1 || 0.28.2": true,
    "workerd@1.20260926.1": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.142.0"
  }
}
