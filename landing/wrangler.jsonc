{
  // Ariadne early-access page: its own tiny Worker, separate from the app ("ariadne").
  // Static files in public/ are served by Cloudflare's asset layer without running this
  // Worker at all (zero Worker CPU). Only /api/* reaches src/worker.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ariadne-landing",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  // No public preview URLs for this Worker's versions.
  "preview_urls": false,
  "observability": { "enabled": true },

  // public/ is generated from site/ by scripts/build.mjs (wrangler runs it on dev and deploy).
  "build": { "command": "node scripts/build.mjs", "watch_dir": ["site"] },

  "assets": {
    "directory": "public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ariadne-early-access",
      // Replace with the id printed by `wrangler d1 create ariadne-early-access` before deploying.
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Attempts per hashed IP per hour on POST /api/early-access (every attempt counts).
    "RATE_LIMIT_PER_HOUR": "8",
    // Browsers on other sites cannot post the form. Requests without an Origin header
    // (curl, scripts) still have to pass Turnstile and the rate limit.
    "ALLOWED_ORIGINS": "http://127.0.0.1:8787,http://localhost:8787",
    // Hostnames a Turnstile token must have been issued on (comma list; empty = skip).
    "TURNSTILE_HOSTNAMES": "localhost"
  },

  // Secrets (never in this file): TURNSTILE_SECRET, HASH_SALT, TOKEN_SECRET.
  // Local values live in .dev.vars (copy .dev.vars.example).

  // Optional waitlist worker. Routes are off by default; add your own domain if needed.
  // the product Worker ("ariadne"). No routes here, so a stray deploy of this Worker can't
  // claim them back. Removing routes from this file does not detach them: that is done in
  // the dashboard. The D1 database "ariadne-early-access" is kept (the first invite pool).
  // To roll back, re-add the two zone routes (example.com/*, www.example.com/*).
}
