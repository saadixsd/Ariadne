{
  "name": "ariadne-landing",
  "version": "0.1.0",
  "description": "Ariadne early-access page: a tiny static Worker with one form endpoint.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "LANDING_DEV=1 wrangler dev --ip 127.0.0.1 --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply ariadne-early-access --local",
    "db:migrate:remote": "wrangler d1 migrations apply ariadne-early-access --remote",
    "typecheck": "tsc -p .",
    "test": "node --experimental-strip-types --test tests/validate.test.ts tests/token.test.ts",
    "test:smoke": "node tests/smoke.mjs",
    "bench": "node tests/bench-cpu.mjs",
    "export": "scripts/export.sh",
    "deploy": "wrangler deploy"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  },
  "private": true,
  "type": "module"
}
