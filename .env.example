# Copy to .env and fill in YOUR keys. Never commit .env.
# You pay Anthropic / OpenAI directly (bring your own keys).

DATABASE_URL="file:./dev.db"

# Required — your own keys (BYOK)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Models (override as you like)
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Local / self-host: lift multi-tenant daily quotas so your own keys are not throttled
ARIADNE_SELF_HOST=1

# Optional: public site URL for metadata / sitemap (defaults to http://localhost:3000)
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Help / privacy contact. When unset, the app links to GitHub Issues.
# CONTACT_EMAIL="you@example.com"

# Sign-up guards (all optional locally).
# Turnstile is off locally when TURNSTILE_SECRET is empty. Cloudflare's test keys:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"   (widget, always passes)
#   TURNSTILE_SECRET="1x0000000000000000000000000000000AA"      (server, always passes)
#   TURNSTILE_SECRET="2x0000000000000000000000000000000AA"      (server, always fails)
# For a production deploy, set a real Turnstile site key + secret, or leave
# TURNSTILE_SECRET empty only in local/dev (production refuses sign-ups without it).
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET=""
# Optional: only accept tokens issued on these hostnames (comma list).
TURNSTILE_HOSTNAMES=""
# Optional: comma list of invite codes. When set, sign-up is invite-only.
INVITE_CODES=""
# Invite codes that make the account a tester (lib/limits.ts). Comma-separated.
TESTER_INVITE_CODES=""
