DATABASE_URL="file:./dev.db"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Production uses ANTHROPIC_MODEL="claude-sonnet-5-5" and OPENAI_MODEL="gpt-6-luna" (wrangler.jsonc vars).
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Sign-up guards (all optional locally).
# Turnstile is off locally when TURNSTILE_SECRET is empty. Cloudflare's test keys:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"   (widget, always passes)
#   TURNSTILE_SECRET="1x0000000000000000000000000000000AA"      (server, always passes)
#   TURNSTILE_SECRET="2x0000000000000000000000000000000AA"      (server, always fails)
# Production: the site key is built in (lib/turnstile-site-key.ts) and TURNSTILE_SECRET is a
# Worker secret on "ariadne". Without it, production refuses sign-ups.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET=""
# Optional: only accept tokens issued on these hostnames (comma list).
TURNSTILE_HOSTNAMES=""
# Optional: comma list of invite codes. When set, sign-up is invite-only.
INVITE_CODES=""
# Invite codes (also listed in INVITE_CODES, or used while sign-up is open) that make the account
# a tester: 3 runs a day for 14 days (lib/limits.ts). Comma-separated, e.g. "lab-oct".
TESTER_INVITE_CODES=""
