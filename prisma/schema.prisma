generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  passwordHash  String
  passwordSalt  String
  emailVerified Boolean            @default(false)
  firstName     String?
  lastName      String?
  /// The invite code used at sign-up (INVITE_CODES), or null for an open sign-up.
  inviteCode    String?
  /// Campaign attribution, first touch (outreach link ?ref=…&utm_…). No PII in these.
  refCode          String?
  utmSource        String?
  utmCampaign      String?
  /// When the first-completion feedback prompt was shown (answered or dismissed).
  feedbackPromptAt DateTime?
  /// First-run intro finished or skipped (null: show it on the next app page).
  introSeenAt      DateTime?
  createdAt     DateTime           @default(now())
  sessions      Session[]
  codes         VerificationCode[]
  resets        PasswordReset[]
  projects      Project[]
  usage         UsageDay[]
  feedback      Feedback[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageDay {
  id     String @id @default(cuid())
  userId String
  day    String
  runs   Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model Project {
  id        String          @id @default(cuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  brief     String
  template  String          @default("landing")
  /// Explicit final approval of the deliverable; approvedHash is the output it approved.
  approvedAt   DateTime?
  approvedHash String?
  createdAt DateTime        @default(now())
  agents    Agent[]
  issueDecisions IssueDecision[]
  sources        SourceFile[]
  tasks     Task[]
  events    ActivityEvent[]
}

model Agent {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  provider  String
  model     String
  role      String
  status    String  @default("idle")
  tasks     Task[]
}

model Task {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentId          String
  agent            Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title            String
  instructions     String
  status           String    @default("pending")
  dependsOn        String    @default("[]")
  requiresApproval Boolean   @default(false)
  output           String?
  model            String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  runs             TaskRun[]

  @@index([projectId])
}

/// Immutable run history. One row per logical run attempt (model call, human
/// gate packaging, reclaimed or discarded attempt). Application code only ever
/// INSERTs into this table; rows disappear only when their task is deleted
/// (project reset / delete) via the FK cascade.
model TaskRun {
  id           String    @id @default(cuid())
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId    String
  /// 1-based ordinal per task.
  attempt      Int
  /// succeeded | failed | reclaimed | discarded | legacy
  outcome      String
  provider     String?
  model        String?
  systemPrompt String?
  prompt       String?
  output       String?
  error        String?
  latencyMs    Int?
  /// Provider-level tries inside this run (withOneRetry), not separate rows.
  tries        Int       @default(1)
  inputTokens     Int?
  outputTokens    Int?
  cacheReadTokens Int?
  /// Provider-side web searches and page fetches.
  toolCalls       Int?
  /// Estimate from list prices (lib/cost.ts).
  costUsd         Float?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([taskId, attempt])
  @@index([projectId])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String
  message    String
  taskId     String?
  /// Structured handoff/approval data. The message stays for humans and old clients.
  fromTaskId String?
  toTaskId   String?
  runId      String?
  /// JSON object as text (SQLite/D1), e.g. {"fromAgent":"Odysseus","toAgent":"Daedalus"}.
  payload    String?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

/// Fixed-window IP rate limit counters for auth endpoints. key = "<action>:<ip>:<windowStart>".
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String
  message   String
  rating           Int?
  worked           String?
  wrong            String?
  changeFirst      String?
  projectId        String?
  allowProjectView Boolean  @default(false)
  appVersion       String?
  source           String?
  triage           String?
  triageNote       String?
  createdAt DateTime @default(now())
}

/// Your decision on one Challenge dispute. flagKey is stable for the same dispute text.
model IssueDecision {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String
  flagKey   String
  state     String
  edit      String?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([projectId, flagKey])
}

/// Text extracted in the browser from a file the user added. The file itself is not kept.
model SourceFile {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  mime      String?
  bytes     Int?
  text      String
  /// R2 object key of the original file (u/<userId>/<projectId>/<id>); null when not kept.
  blobKey   String?
  /// When the original is deleted (R2 lifecycle: 3 days). The extracted text stays.
  expiresAt DateTime?
  /// Bytes of the original stored in R2 (counts against the free-tier budget).
  blobBytes Int?
  createdAt DateTime @default(now())

  @@index([projectId])
}

/// One Draft → Challenge → Judge → Tie Off pass on a project: the unit the quota counts.
/// Opens on the first model run of a project (or after its deliverable was approved) and
/// closes when the deliverable is approved. Model runs inside it (reruns, Intervene,
/// revisions) are not counted against the daily workflows, up to a hidden cap.
model Workflow {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  day       String
  runs      Int      @default(0)
  status    String   @default("open")
  createdAt DateTime @default(now())
  closedAt  DateTime?

  @@index([userId, day])
  @@index([projectId, status])
}

/// Site-wide R2 writes per UTC day (free-tier guard, lib/r2-budget.ts).
model R2Day {
  day    String @id
  writes Int    @default(0)
}

/// Forgot password: single-use reset links. Only the token's SHA-256 is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
