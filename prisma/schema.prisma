generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  passwordHash  String
  passwordSalt  String
  emailVerified Boolean            @default(false)
  firstName     String?
  lastName      String?
  createdAt     DateTime           @default(now())
  sessions      Session[]
  codes         VerificationCode[]
  projects      Project[]
  usage         UsageDay[]
  feedback      Feedback[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageDay {
  id     String @id @default(cuid())
  userId String
  day    String
  runs   Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model Project {
  id        String          @id @default(cuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  brief     String
  template  String          @default("landing")
  createdAt DateTime        @default(now())
  agents    Agent[]
  tasks     Task[]
  events    ActivityEvent[]
}

model Agent {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  provider  String
  model     String
  role      String
  status    String  @default("idle")
  tasks     Task[]
}

model Task {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentId          String
  agent            Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title            String
  instructions     String
  status           String    @default("pending")
  dependsOn        String    @default("[]")
  requiresApproval Boolean   @default(false)
  output           String?
  model            String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  runs             TaskRun[]

  @@index([projectId])
}

/// Immutable run history. One row per logical run attempt (model call, human
/// gate packaging, reclaimed or discarded attempt). Application code only ever
/// INSERTs into this table; rows disappear only when their task is deleted
/// (project reset / delete) via the FK cascade.
model TaskRun {
  id           String    @id @default(cuid())
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId    String
  /// 1-based ordinal per task.
  attempt      Int
  /// succeeded | failed | reclaimed | discarded | legacy
  outcome      String
  provider     String?
  model        String?
  systemPrompt String?
  prompt       String?
  output       String?
  error        String?
  latencyMs    Int?
  /// Provider-level tries inside this run (withOneRetry), not separate rows.
  tries        Int       @default(1)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([taskId, attempt])
  @@index([projectId])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String
  message    String
  taskId     String?
  /// Structured handoff/approval data. The message stays for humans and old clients.
  fromTaskId String?
  toTaskId   String?
  runId      String?
  /// JSON object as text (SQLite/D1), e.g. {"fromAgent":"Odysseus","toAgent":"Daedalus"}.
  payload    String?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

/// Fixed-window IP rate limit counters for auth endpoints. key = "<action>:<ip>:<windowStart>".
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String
  message   String
  createdAt DateTime @default(now())
}
