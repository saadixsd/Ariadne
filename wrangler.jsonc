{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ariadne",
  // Optional Cloudflare deploy template. Replace account_id, D1/R2 ids, and routes with yours.
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "main": ".open-next/worker.js",
  // No *.workers.dev URL by default; set workers_dev / routes for your own domain.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ariadne",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Original uploaded files (PDF/DOCX/MD), one prefix per user: u/<userId>/<projectId>/<sourceId>.
  // Create the bucket BEFORE deploying, or the deploy fails. See docs/WORKSPACE.md.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "ariadne-uploads" }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ariadne"
    }
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  // Add your own routes when you deploy, e.g.:
  // "routes": [{ "pattern": "your.domain/*", "zone_name": "your.domain" }],
  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-4-6",
    "OPENAI_MODEL": "gpt-4o-mini",
    "ARIADNE_SELF_HOST": "1",
    // Turnstile tokens are only accepted when issued on these hostnames (lib/signup-guard.ts).
    "TURNSTILE_HOSTNAMES": ""
  }
  // No "previews" block on purpose: a shared preview DB + paid API keys is unsafe.
  // If you want previews, create a separate D1 and bind only that, with no paid API keys.
}
